{
  "name": "mail-right",
  "version": "0.1.0",
  "private": true,
  "description": "A local mail client for iCloud and Gmail.",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "next dev",
    "dev:mail": "bun --watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "bun run scripts/package-mac.ts"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "hono": "^4.13.13",
    "imapflow": "^2.5.4",
    "lucide-react": "^1.59.0",
    "mailparser": "^3.9.44",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "build": {
    "electronVersion": "44.9.0",
    "appId": "com.mailright.app",
    "productName": "Mailright",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-server/mailright-server",
        "to": "mailright-server"
      },
      {
        "from": ".next-pack/standalone",
        "to": "standalone"
      },
      {
        "from": ".next-pack/standalone/node_modules",
        "to": "standalone/node_modules"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/icon.icns",
      "identity": null,
      "target": [
        "dmg"
      ]
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "electron",
    "sharp",
    "unrs-resolver"
  ]
}
